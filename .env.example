# ── xAI ───────────────────────────────────────────────────────────────────────
XAI_API_KEY=xai-...

# Modelo de Grok (grok-3-latest por defecto)
# Otros disponibles: grok-3-mini-latest, grok-2-latest
AI_MODEL=grok-3-latest

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=credentials/credentials.json
GOOGLE_TOKEN_FILE=credentials/token.json

# ── Gmail ─────────────────────────────────────────────────────────────────────
# Búsqueda de correos. Personaliza según tus necesidades.
GMAIL_QUERY=has:attachment filename:pdf is:unread

# Etiqueta que se aplica al correo una vez procesado
PROCESSED_LABEL=factura-procesada

# ── Google Sheets ─────────────────────────────────────────────────────────────
# ID del spreadsheet (la parte larga de la URL de tu hoja)
# Ejemplo: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# Nombre de la pestaña donde se registrarán las facturas
SHEET_NAME=Facturas

# ── Almacenamiento local ──────────────────────────────────────────────────────
# Carpeta base donde se guardarán las facturas (organizadas por emisor)
INVOICES_DIR=invoices

# ── App ────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
